{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NoteDb": ""
  },
  "Jwt": {
    "Issuer": "NoteService",
    "Audience": "NoteService",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "App": {
    "PublicBaseUrl": "https://notes.example.com",
    "RequireConfirmedEmail": true,
    "InviteLifetimeDays": 7
  },
  "Notes": { "VersionIntervalMinutes": 5 },
  "Attachments": { "MaxBytes": 10485760 },
  "Search": { "UseFullText": false },
  "BlobStorage": { "RootPath": "App_Data/blobs" },
  "Maintenance": { "Enabled": true, "IntervalSeconds": 60, "TrashRetentionDays": 30 },
  "RateLimiting": { "PermitPerMinute": 300, "AuthPermitPerMinute": 10 },
  "Cors": { "AllowedOrigins": [] }
}
