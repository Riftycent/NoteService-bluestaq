{
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "NoteService.Infrastructure.Email.LoggingEmailSender": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "NoteDb": "Server=(localdb)\\MSSQLLocalDB;Database=NoteService;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "SigningKey": "development-only-signing-key-change-me-0123456789"
  },
  "App": {
    "PublicBaseUrl": "http://localhost:3000",
    "RequireConfirmedEmail": false
  },
  "Cors": { "AllowedOrigins": [ "http://localhost:3000" ] }
}
